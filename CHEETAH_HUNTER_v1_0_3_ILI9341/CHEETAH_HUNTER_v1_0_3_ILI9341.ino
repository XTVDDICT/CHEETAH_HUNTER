void handleSave() {
  String saveSection = server.hasArg("section") ? server.arg("section") : "display";
  bool wantsJson = server.hasArg("response") && server.arg("response") == "json";
  bool displaySave = (saveSection != "mining");

  if (displaySave) {
    String newWallet = server.hasArg("wallet") ? server.arg("wallet") : cfgWallet;
    String newCurrency = server.hasArg("currency") ? server.arg("currency") : cfgCurrency;
    newWallet.trim();
    newCurrency = normalizeCurrency(newCurrency);
    bool newFlip = server.hasArg("flip");
    bool walletChanged = (newWallet != cfgWallet);
    bool currencyChanged = (newCurrency != currentCurrencyCode());

    cfgWallet = newWallet;
    cfgCurrency = newCurrency;
    cfgFlip = newFlip;

    if (walletChanged) {
      haveWalletData = false;
      popupActive = false;
      popupPersistent = false;
      popupUntil = 0;
      deltaCHTA = 0.0f;
      lastBalanceCHTA = -1.0f;
      lastMinedTxId = "";
      minedBaselineReady = false;
      lastMinedAlertCheck = millis();
    }

    syncFiatAvailability();
    savePrefs();

    String message = "Display settings saved.";
    if (walletChanged && !cfgWallet.isEmpty()) {
      message = "Display settings saved. Wallet data is refreshing in the background.";
    } else if (currencyChanged && !cfgWallet.isEmpty()) {
      message = "Display settings saved. Currency data is refreshing in the background.";
    }

    if (wantsJson) {
      sendSaveResult(true, "display", message);
    } else {
      server.sendHeader("Location", "/?saved=display", true);
      server.send(303, "text/plain", "");
    }

    applyRotation();
    drawStaticLayout();
    drawValues();

    if (WiFi.status() == WL_CONNECTED && !cfgWallet.isEmpty()) {
      scheduleDataRefresh(walletChanged, walletChanged || currencyChanged);
    }
    return;
  }

  bool newMiningEnabled = server.hasArg("mining_enabled");
  String newPoolHost = server.hasArg("mine_host") ? server.arg("mine_host") : cfgMiningPoolHost;
  String newPoolPort = server.hasArg("mine_port") ? server.arg("mine_port") : cfgMiningPoolPort;
  String newMiningUser = server.hasArg("mine_user") ? server.arg("mine_user") : cfgMiningUser;
  String newMiningWorker = server.hasArg("mine_worker") ? server.arg("mine_worker") : cfgMiningWorker;
  String newMiningPass = server.hasArg("mine_pass") ? server.arg("mine_pass") : cfgMiningPass;
  newPoolHost.trim();
  newPoolPort.trim();
  newMiningUser.trim();
  newMiningWorker.trim();
  newMiningPass.trim();
  if (newPoolPort.isEmpty()) newPoolPort = "3333";
  if (newMiningPass.isEmpty()) newMiningPass = "x";

  if (newMiningEnabled && newPoolHost.isEmpty()) {
    sendSaveResult(false, "mining", "Enter a pool host before enabling mining.", 400);
    return;
  }
  if (newMiningEnabled && !validPoolPort(newPoolPort)) {
    sendSaveResult(false, "mining", "Pool port must be a number from 1 to 65535.", 400);
    return;
  }
  if (newMiningEnabled && newMiningUser.isEmpty() && cfgWallet.isEmpty()) {
    sendSaveResult(false, "mining", "Enter a wallet or pool username before enabling mining.", 400);
    return;
  }

  cfgMiningEnabled = newMiningEnabled;
  cfgMiningPoolHost = newPoolHost;
  cfgMiningPoolPort = newPoolPort;
  cfgMiningUser = newMiningUser;
  cfgMiningWorker = newMiningWorker;
  cfgMiningPass = newMiningPass;
  savePrefs();

  String message = cfgMiningEnabled
    ? "Mining settings saved. Reconnecting to the pool."
    : "Mining settings saved. Mining is turned off.";
  if (wantsJson) {
    sendSaveResult(true, "mining", message);
  } else {
    server.sendHeader("Location", "/?saved=mining#mining", true);
    server.send(303, "text/plain", "");
  }

  soloHunterMinerConfigure(currentMiningEngineConfig());
  drawStaticLayout();
  drawValues();
}

