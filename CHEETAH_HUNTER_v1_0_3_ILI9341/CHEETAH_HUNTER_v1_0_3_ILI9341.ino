bool fetchChtaBalance() {
  if (WiFi.status() != WL_CONNECTED) {
    statusText = "BAL RETRY";
    return false;
  }

  if (cfgWallet.isEmpty()) {
    statusText = "NO WALLET CONFIG";
    return false;
  }

  SoloHunterMinerHashPause hashPause;
  WiFiClient client;
  HTTPClient http;
  http.setConnectTimeout(BALANCE_CONNECT_TIMEOUT_MS);
  http.setTimeout(BALANCE_HTTP_TIMEOUT_MS);
  http.setUserAgent("ESP32-CHEETAH-HUNTER/1.0.3");

  if (!http.begin(client, chainzUrl())) {
    statusText = "BAL RETRY";
    return false;
  }

  int code = http.GET();
  if (code != 200) {
    statusText = "BAL HTTP " + String(code);
    http.end();
    return false;
  }

  String body = http.getString();
  http.end();
  body.trim();

  if (!body.length() || body.startsWith("ERROR")) {
    statusText = "BAL RETRY";
    return false;
  }

  balanceCHTA = body.toFloat();
  haveWalletData = true;
  return true;
}


bool applyCoinpaprikaFiatPrices(const String& body) {
  bool updated = false;
  float usd = extractCoinpaprikaQuotePrice(body, "USD");
  float gbp = extractCoinpaprikaQuotePrice(body, "GBP");
  float cad = extractCoinpaprikaQuotePrice(body, "CAD");

  if (usd > 0.0f) {
    chtaPriceUsd = usd;
    updated = true;
  }
  if (gbp > 0.0f) {
    chtaPriceGbp = gbp;
    updated = true;
  }
  if (cad > 0.0f) {
    chtaPriceCad = cad;
    updated = true;
  }

  if (!updated) return false;

  saveLastFiatPrices();
  syncFiatAvailability();
  return haveFiatData;
}

bool fetchGleecWalletUsdPrice(float& price) {
  price = 0.0f;

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(PRICE_CONNECT_TIMEOUT_MS);
  http.setTimeout(PRICE_HTTP_TIMEOUT_MS);
  http.setUserAgent("ESP32-CHEETAH-HUNTER/1.0.3");

  if (!http.begin(client, gleecWalletTickersUrl())) return false;

  int code = http.GET();
  if (code != 200) {
    http.end();
    return false;
  }

  WiFiClient* stream = http.getStreamPtr();
  const char* key = "\"CHTA\":";
  size_t matched = 0;
  bool foundKey = false;
  bool inObject = false;
  int braceDepth = 0;
  String obj;
  obj.reserve(420);

  unsigned long deadline = millis() + PRICE_HTTP_TIMEOUT_MS;
  while (http.connected() && millis() < deadline) {
    while (stream->available()) {
      char c = (char)stream->read();

      if (!foundKey) {
        if (c == key[matched]) {
          matched++;
          if (key[matched] == '\0') foundKey = true;
        } else {
          matched = (c == key[0]) ? 1 : 0;
        }
        continue;
      }

      if (!inObject) {
        if (c == '{') {
          inObject = true;
          braceDepth = 1;
          obj = "{";
        }
        continue;
      }

      obj += c;
      if (c == '{') {
        braceDepth++;
      } else if (c == '}') {
        braceDepth--;
        if (braceDepth == 0) {
          http.end();
          price = extractJsonFloat(obj, "\"last_price\":");
          return price > 0.0f;
        }
      }

      if (obj.length() > 900) {
        http.end();
        return false;
      }
    }
    delay(1);
  }

  http.end();
  return false;
}

void markFiatFetchFailed(const String& detail) {
  syncFiatAvailability();
  if (haveWalletData) {
    statusText = liveCurrencyWaitStatus();
  } else {
    statusText = detail;
  }
}

bool fetchChtaFiatPrices() {
  if (WiFi.status() != WL_CONNECTED) {
    markFiatFetchFailed(currentCurrencyRetryText());
    return false;
  }

  SoloHunterMinerHashPause hashPause;

  float usd = 0.0f;
  if (fetchGleecWalletUsdPrice(usd)) {
    chtaPriceUsd = usd;
    saveLastFiatPrices();
    syncFiatAvailability();
    if (currentCurrencyCode() == "USD") return haveFiatData;
  }

  WiFiClientSecure client;
  client.setInsecure();
  HTTPClient http;
  http.setConnectTimeout(PRICE_CONNECT_TIMEOUT_MS);
  http.setTimeout(PRICE_HTTP_TIMEOUT_MS);
  http.setUserAgent("ESP32-CHEETAH-HUNTER/1.0.3");

  if (!http.begin(client, coinpaprikaTickerUrl())) {
    markFiatFetchFailed(currentCurrencyRetryText());
    return false;
  }

  int code = http.GET();
  if (code != 200) {
    String detail = (code == 429) ? "PRICE RATE LIMIT" : currentCurrencyCode() + " HTTP " + String(code);
    http.end();
    markFiatFetchFailed(detail);
    return false;
  }

  String body = http.getString();
  http.end();

  if (applyCoinpaprikaFiatPrices(body)) return true;

  markFiatFetchFailed(currentCurrencyCode() + " PARSE FAIL");
  return false;
}


bool fetchLatestMinedTx(String& txid, float& received) {
  if (WiFi.status() != WL_CONNECTED || cfgWallet.isEmpty()) return false;

  SoloHunterMinerHashPause hashPause;
  WiFiClient client;
  HTTPClient http;
  http.setConnectTimeout(BALANCE_CONNECT_TIMEOUT_MS);
  http.setTimeout(BALANCE_HTTP_TIMEOUT_MS);
  http.setUserAgent("ESP32-CHEETAH-HUNTER/1.0.3");

  if (!http.begin(client, minedTxUrl())) return false;

  int code = http.GET();
  if (code != 200) {
    http.end();
    return false;
  }

  String body = http.getString();
  http.end();
  return extractLatestMinedTx(body, txid, received);
}

void checkForMinedBlockAlert() {
  if (WiFi.status() != WL_CONNECTED || cfgWallet.isEmpty()) return;

  String txid;
  float received = 0.0f;
  bool foundMinedTx = fetchLatestMinedTx(txid, received);

  if (!minedBaselineReady) {
    if (foundMinedTx) lastMinedTxId = txid;
    minedBaselineReady = true;
    saveMinedAlertState();
    return;
  }

  if (!foundMinedTx || txid.isEmpty() || txid == lastMinedTxId) return;

  lastMinedTxId = txid;
  if (received > 0.0f || !popupActive) {
    startBlockPopup(received);
  }
  saveMinedAlertState();
}

void refreshWalletOnly() {
  bool balOk = fetchChtaBalance();
  if (balOk) {
    statusText = "LIVE " + WiFi.localIP().toString();

    if (lastBalanceCHTA < 0.0f) {
      lastBalanceCHTA = balanceCHTA;
      saveLastBalance();
    } else if (balanceCHTA != lastBalanceCHTA) {
      if (balanceCHTA > lastBalanceCHTA) {
        startBlockPopup(balanceCHTA - lastBalanceCHTA);
      }
      lastBalanceCHTA = balanceCHTA;
      saveLastBalance();
    }
  } else if (haveWalletData) {
    statusText = "LIVE / BAL RETRY";
  }
}

void refreshFiatOnly() {
  if (!haveWalletData || cfgWallet.isEmpty()) return;
  bool fiatOk = fetchChtaFiatPrices();
  if (fiatOk) {
    statusText = "LIVE " + WiFi.localIP().toString();
  } else if (haveWalletData && haveFiatData) {
    statusText = liveCurrencyWaitStatus();
  }
}

bool validPoolPort(const String& portText) {
  if (portText.isEmpty()) return false;
  for (size_t i = 0; i < portText.length(); ++i) {
    if (!isDigit(portText[i])) return false;
  }
  long port = portText.toInt();
  return port > 0 && port <= 65535;
}

void scheduleDataRefresh(bool walletRefresh, bool fiatRefresh) {
  pendingWalletRefresh = pendingWalletRefresh || walletRefresh;
  pendingFiatRefresh = pendingFiatRefresh || fiatRefresh;
  pendingDataRefreshAt = millis() + 2500;
}

void servicePendingDataRefresh() {
  if (!(pendingWalletRefresh || pendingFiatRefresh)) return;
  if ((int32_t)(millis() - pendingDataRefreshAt) < 0) return;

  if (pendingWalletRefresh) {
    pendingWalletRefresh = false;
    refreshWalletOnly();
    lastWalletFetch = millis();
    drawValues();
    pendingDataRefreshAt = millis() + 250;
    return;
  }

  pendingFiatRefresh = false;
  refreshFiatOnly();
  lastFiatFetch = millis();
  drawValues();
}

void sendSaveResult(bool ok, const String& section, const String& message,
                    int statusCode = 200) {
  String json = "{\"ok\":" + String(ok ? "true" : "false") +
                ",\"section\":\"" + jsonEscape(section) +
                "\",\"message\":\"" + jsonEscape(message) + "\"}";
  server.sendHeader("Cache-Control", "no-store");
  server.send(statusCode, "application/json", json);
}

