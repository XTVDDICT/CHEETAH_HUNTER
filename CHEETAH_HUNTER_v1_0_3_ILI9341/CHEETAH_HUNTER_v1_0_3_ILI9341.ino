  json += "\"mining_pool_port\":" + cfgMiningPoolPort + ",";
  json += "\"mining_worker\":\"" + jsonEscape(cfgMiningWorker) + "\",";
  json += "\"mining_engine\":\"" + String(cfgMiningEnabled ? (miningHardwareSha ? "HW SHA" : "CPU FALLBACK") : "OFF") + "\",";
  json += "\"mining_hashrate_kh\":" + String(miningHashrateKh, 3) + ",";
  json += "\"mining_total_hashes\":" + uint64Text(miningTotalHashes) + ",";
  json += "\"mining_submitted_shares\":" + String(miningSubmittedShares) + ",";
  json += "\"mining_pending_shares\":" + String(miningPendingShares) + ",";
  json += "\"mining_accepted_shares\":" + String(miningAcceptedShares) + ",";
  json += "\"mining_rejected_shares\":" + String(miningRejectedShares) + ",";
  json += "\"mining_blocks_found\":" + String(miningBlocksFound) + ",";
  json += "\"mining_uptime_seconds\":" + String(miningUptimeSeconds) + ",";
  json += "\"mining_best_diff\":" + String(miningBestDiff, 4) + ",";
  json += "\"mining_pool_difficulty\":" + String(miningPoolDifficulty, 6) + ",";
  json += "\"refresh_pending\":" + String((pendingWalletRefresh || pendingFiatRefresh) ? "true" : "false") + ",";
