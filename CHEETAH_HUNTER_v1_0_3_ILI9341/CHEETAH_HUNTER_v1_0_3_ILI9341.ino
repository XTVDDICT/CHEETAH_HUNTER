      drawPoundGlyph2x(poundX, 196, C_GREEN, C_BG);
      tft.setCursor(amountX, 196);
      tft.print(fiatAmountText);
    } else {
      int fiatX = 296 - tft.textWidth(fiatText);
      if (fiatX < 144) fiatX = 144;
      tft.setCursor(fiatX, 196);
      tft.print(fiatText);
