String chainzUrl() {
  // Iquidus-style explorer API for Cheetahcoin balance.
  return String("http://chtaexplorer.mooo.com:3002/ext/getbalance/") + cfgWallet;
}

String coinpaprikaTickerUrl() {
  return String("https://api.coinpaprika.com/v1/tickers/chta-cheetahcoin?quotes=USD,GBP,CAD");
}

String gleecWalletTickersUrl() {
  return String("https://defistats.gleec.com/api/v3/prices/tickers_v2?expire_at=600");
}

String minedTxUrl() {
  // Placeholder: Cheetahcoin public explorer may not expose the same mined-transaction API used by the original build.
  return String("http://chtaexplorer.mooo.com:3002/ext/getaddress/") + cfgWallet;
}

class LGFX : public lgfx::LGFX_Device {
  lgfx::Panel_ST7789 _panel;
  lgfx::Bus_SPI _bus;
public:
  LGFX(void) {
    {
      auto cfg = _bus.config();
      cfg.spi_host = HSPI_HOST;
      cfg.spi_mode = 0;
      cfg.freq_write = 40000000;
      cfg.freq_read = 16000000;
      cfg.spi_3wire = false;
      cfg.use_lock = true;
      cfg.dma_channel = 1;
      cfg.pin_sclk = 14;
      cfg.pin_mosi = 13;
      cfg.pin_miso = 12;
      cfg.pin_dc   = 2;
      _bus.config(cfg);
      _panel.setBus(&_bus);
    }
    {
      auto cfg = _panel.config();
      cfg.pin_cs = 15;
      cfg.pin_rst = -1;
      cfg.pin_busy = -1;
      cfg.memory_width = 240;
      cfg.memory_height = 320;
      cfg.panel_width = 240;
      cfg.panel_height = 320;
      cfg.offset_x = 0;
      cfg.offset_y = 0;
      cfg.offset_rotation = 0;
      cfg.dummy_read_pixel = 8;
      cfg.dummy_read_bits = 1;
      cfg.readable = true;
      cfg.invert = false;
      cfg.rgb_order = false;
      cfg.dlen_16bit = false;
      cfg.bus_shared = true;
      _panel.config(cfg);
    }
    setPanel(&_panel);
  }
} tft;

