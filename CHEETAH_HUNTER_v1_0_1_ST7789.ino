void handleSave() {
  String oldWallet = cfgWallet;
  if (server.hasArg("wallet")) cfgWallet = server.arg("wallet");
  if (server.hasArg("currency")) cfgCurrency = server.arg("currency");
  cfgFlip = server.hasArg("flip");
  trimConfig();
  bool walletChanged = (cfgWallet != oldWallet);

  if (walletChanged) {
    haveWalletData = false;
    popupActive = false;
    popupPersistent = false;
    popupUntil = 0;
    deltaCHTA = 0.0f;
    lastBalanceCHTA = -1.0f;
    lastMinedTxId = "";
    minedBaselineReady = false;
  }

  syncFiatAvailability();
  savePrefs();
  applyRotation();

  if (WiFi.status() == WL_CONNECTED) {
    refreshWalletOnly();
    refreshFiatOnly();
    checkForMinedBlockAlert();
  }

  drawStaticLayout();
  drawValues();
  lastWalletFetch = millis();
  lastFiatFetch = millis();
  lastMinedAlertCheck = millis();

  server.sendHeader("Location", "/", true);
  server.send(303, "text/plain", "");
}

void handleOpenWifiPortal() {
  portalMode = true;
  server.send(200, "text/html",
    "<!doctype html><html><head><meta name='viewport' content='width=device-width,initial-scale=1'>"
    "<title>WiFi Setup Requested</title>"
    "<style>body{margin:0;min-height:100vh;display:grid;place-items:center;background:#08100a;color:#edf7f0;font-family:'Trebuchet MS','Segoe UI',sans-serif;padding:20px}"
    ".card{max-width:520px;padding:24px;border-radius:22px;background:linear-gradient(180deg,#152319,#0b140e);border:1px solid #294433;box-shadow:0 24px 60px rgba(0,0,0,.35)}"
    "h2{margin:0 0 10px;color:#62ff9b}p{margin:0;color:#9db5a5;line-height:1.6}</style></head><body><div class='card'>"
    "<h2>WiFi portal requested.</h2><p>The device is switching into setup mode now. Connect to the CHEETAH_HUNTER_SETUP network if prompted.</p>"
    "</div></body></html>");
}

void handleClearPopup() {
  clearBlockPopup();
  server.sendHeader("Location", "/", true);
  server.send(303, "text/plain", "");
}

void handleStatusJson() {
  syncFiatAvailability();
  walletFiatValue = currentWalletFiatValue();
  String currencyCode = currentCurrencyCode();
  String json = "{";
  json += "\"ip\":\"" + currentIpText() + "\",";
  json += "\"status\":\"" + statusText + "\",";
  json += "\"currency\":\"" + currencyCode + "\",";
  json += "\"currency_name\":\"" + currencyDisplayName(currencyCode) + "\",";
  json += "\"balance_chta\":" + String(balanceCHTA, 8) + ",";
  json += "\"chta_usd\":" + String(chtaPriceUsd, 8) + ",";
  json += "\"chta_gbp\":" + String(chtaPriceGbp, 8) + ",";
  json += "\"chta_cad\":" + String(chtaPriceCad, 8) + ",";
  json += "\"chta_fiat\":" + String(currentChtaFiatPrice(), 8) + ",";
  json += "\"chta_raw_fiat\":" + String(currentRawChtaFiatPrice(), 8) + ",";
  json += "\"price_source\":\"gleec_wallet_tickers_v2_or_coinpaprika\",";
  json += "\"wallet_fiat\":" + String(walletFiatValue, 8) + ",";
  json += "\"wallet_usd\":" + String(balanceCHTA * chtaPriceUsd, 8) + ",";
  json += "\"wallet_configured\":" + String(cfgWallet.isEmpty() ? "false" : "true") + ",";
  json += "\"have_wallet_data\":" + String(haveWalletData ? "true" : "false") + ",";
  json += "\"have_fiat_data\":" + String(haveFiatData ? "true" : "false") + ",";
  json += "\"flip\":" + String(cfgFlip ? "true" : "false");
  json += "}";
  server.send(200, "application/json", json);
}

void setupWebServer() {
  server.on("/", HTTP_GET, handleRoot);
  server.on("/save", HTTP_POST, handleSave);
  server.on("/clear-popup", HTTP_POST, handleClearPopup);
  server.on("/wifi", HTTP_POST, handleOpenWifiPortal);
  server.on("/status", HTTP_GET, handleStatusJson);
  server.begin();
}

void runWifiManagerPortal() {
  WiFiManager wm;
  portalMode = true;
  drawStaticLayout();
  statusText = "CONNECT TO CHEETAH_HUNTER_SETUP WIFI";
  drawValues();
  wm.setConfigPortalTimeout(180);
  bool connected = wm.autoConnect(AP_SSID, AP_PASS);

  if (!connected) {
    statusText = "WIFI PORTAL TIMEOUT";
    drawValues();
    return;
  }

  portalMode = false;
  statusText = cfgWallet.isEmpty() ? "NO WALLET CONFIG" : "LIVE " + WiFi.localIP().toString();
  drawValues();
}

void setup() {
  pinMode(TFT_BL, OUTPUT);
  digitalWrite(TFT_BL, HIGH);

  pinMode(REAR_LED, OUTPUT);
  rearLedOn();

  tft.init();
  loadPrefs();
  applyRotation();
  tft.setTextDatum(top_left);
  tft.fillScreen(C_BG);

  drawStaticLayout();
  statusText = "STARTING WIFI...";
  drawValues();

  if (WiFi.status() != WL_CONNECTED) {
    runWifiManagerPortal();
  }

  setupWebServer();

  if (WiFi.status() == WL_CONNECTED) {
    refreshWalletOnly();
    refreshFiatOnly();
    checkForMinedBlockAlert();
  }

  drawStaticLayout();
  drawValues();

  if (isBlockPopupVisible()) drawBlockPopup();

  lastWalletFetch = millis();
  lastFiatFetch = millis();
  lastMinedAlertCheck = millis();
}

void loop() {
  rearLedOn();
  server.handleClient();

  if (portalMode) {
    runWifiManagerPortal();
    drawStaticLayout();
    drawValues();
  }

  if (WiFi.status() != WL_CONNECTED) {
    delay(100);
    return;
  }

  // POPUP LOCK: freeze background updates while popup is active
  if (popupActive) {
    if (!isBlockPopupVisible()) {
      clearBlockPopup();
    } else {
      // do nothing except keep LED alive
      delay(20);
      return;
    }
  }

  if (millis() - lastWalletFetch >= WALLET_REFRESH_MS) {
    lastWalletFetch = millis();
    refreshWalletOnly();
    drawValues();
  }

  if (millis() - lastFiatFetch >= FIAT_REFRESH_MS) {
    lastFiatFetch = millis();
    refreshFiatOnly();
    drawValues();
  }

  if (millis() - lastMinedAlertCheck >= MINED_ALERT_REFRESH_MS) {
    lastMinedAlertCheck = millis();
    checkForMinedBlockAlert();
    if (isBlockPopupVisible()) drawBlockPopup();
  }

  delay(20);
}
